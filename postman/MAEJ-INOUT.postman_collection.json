            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"month\": \"2026-10\",\n  \"amount\": 32000.00\n}"
            },
            "url": "{{baseUrl}}/api/investment-fund"
          }
        },
        {
          "name": "Consultar saldos",
          "request": {
