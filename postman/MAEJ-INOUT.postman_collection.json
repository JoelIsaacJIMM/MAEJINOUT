            },
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          }
        },
        {
          "name": "Eliminar equipo creado",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          }
        }
      ]
    },
    {
      "name": "Fondo de inversión",
      "item": [
